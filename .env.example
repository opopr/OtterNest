# Generate a random owner token with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTTERNEST_OWNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTTERNEST_DATABASE_URL=postgresql+psycopg://otternest:REPLACE_ME@127.0.0.1:5432/otternest
# Connection, authentication and TLS must be configured separately for actual deployment.

# Optional outbound webhook dispatch (do not set until needed)
OTTERNEST_WEBHOOK_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTTERNEST_WEBHOOK_ALLOWED_HOSTS=events.example.com
# External HTTPS origin used to advertise the A2A v0.3 Agent Card (leave unset until ready).
# OTTERNEST_A2A_BASE_URL=https://agent.example.invalid

# Outbound A2A: exact approved public HTTPS peers, never wildcard or localhost.
# One bearer token per remote endpoint ID is supplied only in the outbound worker environment.
OTTERNEST_A2A_ALLOWED_HOSTS=
# After registering a peer, set its returned variable name in the worker environment:
# OTTERNEST_A2A_REMOTE_TOKEN_<ENDPOINT_UUID_WITH_UNDERSCORES>=...
