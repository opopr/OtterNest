# Generate a random owner token with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTTERNEST_OWNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTTERNEST_DATABASE_URL=postgresql+psycopg://otternest:REPLACE_ME@127.0.0.1:5432/otternest
# Connection, authentication and TLS must be configured separately for actual deployment.
