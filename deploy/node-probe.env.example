# Store the real file at /etc/otternest-node/probe.env, mode 0600.
# Use the HTTPS origin of the OtterNest control plane (do not append /api/v1).
OTTERNEST_SERVER_URL=https://control.example.com
# Create the Runtime in OtterNest Agent management, then paste its stable ID.
OTTERNEST_RUNTIME_ID=REPLACE_RUNTIME_ID
# Issue a dedicated Runtime token for this specific Runtime; never use the owner token.
OTTERNEST_RUNTIME_TOKEN=REPLACE_MONITOR_TOKEN
