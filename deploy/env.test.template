# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OTTERNEST_OWNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# PostgreSQL 16+ DSN (recommended for test server; matches migrations 0001-0016)
OTTERNEST_DATABASE_URL=postgresql+psycopg://otternest:REPLACE_DB_PASSWORD@127.0.0.1:5432/otternest

# Private local artifact storage (keep on persistent disk, back up together with DB)
OTTERNEST_ARTIFACT_DIR=/var/lib/otternest/artifacts

# Bind address for uvicorn (keep 127.0.0.1 behind Nginx/Caddy TLS reverse proxy)
OTTERNEST_HOST=127.0.0.1
OTTERNEST_PORT=8000

# Optional: enable background scheduler daemon inside start_control_plane.sh (1=yes, 0=no)
OTTERNEST_RUN_SCHEDULER=1

# Optional: Webhook & A2A & External Model Planner (leave disabled until verified)
# OTTERNEST_WEBHOOK_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# OTTERNEST_WEBHOOK_ALLOWED_HOSTS=
# OTTERNEST_A2A_BASE_URL=
# OTTERNEST_A2A_ALLOWED_HOSTS=
# OTTERNEST_PLANNER_ALLOW_EXTERNAL=0
