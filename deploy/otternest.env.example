# Copy to /etc/otternest/otternest.env and replace all REPLACE_* values.
# This is a systemd EnvironmentFile, not a shell script. Do not add shell exports.

# Local PostgreSQL peer authentication: Linux service user and DB role are both otternest.
OTTERNEST_DATABASE_URL=postgresql+psycopg:///otternest

# Required. Generate with: openssl rand -hex 32
OTTERNEST_OWNER_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Persistent task artifacts; keep this directory on a backed-up filesystem.
OTTERNEST_ARTIFACT_DIR=/var/lib/otternest/artifacts

# Leave empty for same-origin React served by FastAPI.
# For Google AI Studio preview, list the exact browser Origin(s), comma-separated.
OTTERNEST_CORS_ORIGINS=

# Optional signed outbound webhooks. Configure both only when needed.
OTTERNEST_WEBHOOK_SIGNING_KEY=
OTTERNEST_WEBHOOK_ALLOWED_HOSTS=

# Optional outbound A2A peer allowlist. Remote tokens belong in separate
# endpoint-specific OTTERNEST_A2A_REMOTE_TOKEN_<ENDPOINT_ID> variables.
OTTERNEST_A2A_ALLOWED_HOSTS=
